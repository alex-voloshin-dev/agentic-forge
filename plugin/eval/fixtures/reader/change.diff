diff --git a/src/httpkit/retry.py b/src/httpkit/retry.py
new file mode 100644
index 0000000..5d3e2f1
--- /dev/null
+++ b/src/httpkit/retry.py
@@ -0,0 +1,40 @@
+"""Backoff schedule and the retry rule for idempotent methods."""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Iterator
+from dataclasses import dataclass, field
+
+IDEMPOTENT = frozenset({"GET", "HEAD", "OPTIONS", "PUT", "DELETE"})
+
+
+def should_retry(method: str, status: int) -> bool:
+    """A 5xx answer to an idempotent method is worth one more try."""
+    return method.upper() in IDEMPOTENT and 500 <= status < 600
+
+
+@dataclass
+class Delay:
+    seconds: float
+
+    def wait(self) -> None:
+        time.sleep(self.seconds)
+
+
+@dataclass
+class Backoff:
+    first: float = 0.5
+    attempts: int = 2
+    _left: int = field(init=False, default=0)
+
+    def __iter__(self) -> Iterator[Delay]:
+        self._left = self.attempts + 1
+        seconds = self.first
+        while self._left > 0:
+            self._left -= 1
+            yield Delay(seconds)
+            seconds *= 2
+
+    def more(self) -> bool:
+        return self._left > 0
