 class Transport:
     """Sends requests with the standard library; swap it out in tests."""
 
-    def __init__(self) -> None:
+    def __init__(self, verify: bool = True) -> None:
         self.opener = urllib.request.build_opener()
+        self.verify = verify
 
     def send(
         self, method: str, url: str, *, timeout: float, headers: dict[str, str]
     ) -> Answer:
         request = urllib.request.Request(url, method=method, headers=headers)
         with self.opener.open(request, timeout=timeout) as raw:
             return Answer(raw.status, raw.read().decode())
