@@ -12,30 +12,36 @@ from .client import Client
 
 
 class Session:
     """A client with a bearer token and a cookie jar."""
 
     def __init__(self, client: Client, token: str | None) -> None:
         self.client = client
         self.token = token
         self.cookies: dict[str, str] = {}
 
     def headers(self) -> dict[str, str]:
         out = {}
         if self.token:
             out["authorization"] = f"Bearer {self.token}"
         if self.cookies:
             out["cookie"] = "; ".join(f"{k}={v}" for k, v in self.cookies.items())
         return out
 
     def get(self, url: str) -> dict:
         return self.client.get(url, headers=self.headers())
 
 
-def open_session(base_url: str, token: str | None = None) -> Session:
-    """Open a session against ``base_url``."""
-    return Session(Client(base_url), token)
+def open_session(base_url: str, *, token: str | None = None, verify: bool = True) -> Session:
+    """Open a session against ``base_url``.
+
+    ``verify`` turns TLS certificate checks off only for a test server; never in production.
+    """
+    transport = Transport(verify=verify)
+    return Session(Client(base_url, transport), token)
 
 
 def close_session(session: Session) -> None:
     session.cookies.clear()
