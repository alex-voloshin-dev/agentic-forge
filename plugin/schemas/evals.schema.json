{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-forge/schemas/evals.schema.json",
  "title": "agentic-forge component contract (evals.json)",
  "description": "A SUPERSET of the official skill-creator evals.json. skill-creator reads 'skill_name' and 'evals'; agentic-forge additionally reads 'component', 'thresholds', and 'triggers'. Extra keys are ignored by skill-creator, so a single file serves both.",
  "type": "object",
  "required": ["skill_name", "evals", "component", "thresholds"],
  "additionalProperties": true,
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "description": "Official skill-creator field: the skill under test."
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "description": "Official skill-creator test cases.",
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "expected_output": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "assertions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "type", "purpose"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["skill", "agent", "hook", "script", "workflow", "rule", "kb-template"]
        },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "tier1_trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recall": { "type": "number", "minimum": 0, "maximum": 1 },
            "specificity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "tier2_quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "runs": { "type": "integer", "minimum": 1 },
            "max_overhead_tokens": { "type": "integer", "minimum": 0 },
            "max_overhead_seconds": { "type": "number", "minimum": 0 }
          }
        },
        "tier3_e2e": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenario_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "should_trigger": { "type": "array", "items": { "type": "string" } },
        "should_not_trigger": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
