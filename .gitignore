# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Coverage / test data (generated)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Eval run artifacts (generated; not source of truth)
**/evals/runs/
**/grading.json
**/benchmark.json
**/timing.json

# L4 runtime artifacts (audit/diagnostics logs, scheduler state) — but the committed config stays.
# NOTE: ignore the dir's *contents* (not the dir), else git can't re-include config.json below.
# Cover both the repo root and any nested cwd where a hook/script may create the dir.
.agentic-forge/*
!.agentic-forge/config.json
**/.agentic-forge/*
!**/.agentic-forge/config.json
# The diagnostics-bundle eval stand seeds a repo-side state dir ON PURPOSE (audit + diagnostics
# logs the Tier-2 run windows over); those fixture files are source, so re-include them.
!plugin/eval/fixtures/**/.agentic-forge/*
# Tier-2 roles run pytest in place on fixture COPIES; a stray in-tree run must never be tracked.
plugin/eval/fixtures/**/__pycache__/
eval-report.html

# OS / editor
.DS_Store
.idea/
.vscode/

# Local artifact of the optional `uv` path in CONTRIBUTING — not a project lockfile
uv.lock

# Claude Code agent worktrees (the harness creates them inside the checkout)
.claude/worktrees/
